# Build and tooling artefacts
__pycache__/
*.pyc

# Third-party clones staged by scripts/install-external.py.
# Redistributed skills carry their own licence; we vendor them at install time
# rather than committing other people's trees into this repository.
vendor/

# Node
node_modules/
npm-debug.log*

# Local engagement context. Never commit a real venture's positioning,
# pricing, buyer detail or customer names.
.agents/

# Generated snapshot of THIS machine's full skill corpus. Never publish it: the
# list reveals private projects and tooling. The committed, publishable subset
# lives in catalog/known-skills.public.txt.
catalog/known-skills.local.txt

# Locally declared private skill-name prefixes. Gitignored for the same reason:
# naming the projects in a public file would disclose them.
catalog/.private-prefixes
